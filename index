  <button class="btn ghost sm" style="margin-top:8px" onclick="showConfig()">Trocar projeto</button>
</div></div>

<!-- APP -->
<div id="app" class="hidden">
  <aside><div class="side-logo"><div class="brandimg"></div></div><div class="nav" id="nav"></div></aside>
  <main>
    <div class="topbar">
      <div><h1 id="pgTitle">Painel</h1><div class="sub" id="pgSub"></div></div>
      <div class="spacer"></div>
      <div class="userchip"><div class="avatar" id="uAv">?</div>
        <div><div id="uName" style="font-weight:600"></div><span class="role-badge" id="uRole"></span></div>
        <button class="btn sm ghost" onclick="logout()">Sair</button></div>
    </div>
    <div class="content" id="view"></div>
