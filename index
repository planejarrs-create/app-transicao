window.saveCfgItem=async function(mk,id){const rid=id.replace(/\./g,'_');const desc=$('in_'+rid).value.trim();if(!desc)return alert('Informe o texto.');
  const{error}=await sb.from('item').update({descricao:desc}).eq('id',id);if(error)return alert(error.message);
  const it=(ST.items[mk]||[]).find(x=>x.id===id);if(it)it.descricao=desc;
  const btn=document.querySelector('#cfg_'+rid+' .emerald');if(btn){btn.textContent='Salvo';setTimeout(()=>btn.textContent='Salvar',900);}};
window.delCfgItem=async function(mk,id){if(!confirm('Excluir este item? Remove tambem status e anexos ligados a ele.'))return;
  const{error}=await sb.from('item').delete().eq('id',id);if(error)return alert(error.message);
  ST.items[mk]=(ST.items[mk]||[]).filter(x=>x.id!==id);delete ST.status[id];delete ST.anexos[id];
  configurador($('view'));renderNav();};
window.addCfgItem=async function(mk){const desc=prompt('Texto do novo item:');if(!desc||!desc.trim())return;
  const items=ST.items[mk]||[];const ordem=items.reduce((a,it)=>Math.max(a,it.ordem||0),-1)+1;const id=mk+'.c'+Date.now();
  const{data,error}=await sb.from('item').insert({id,modulo_key:mk,ordem,descricao:desc.trim()}).select().single();
  if(error)return alert(error.message);
  await sb.from('item_status').insert({item_id:id});
  (ST.items[mk]=ST.items[mk]||[]).push(data);ST.status[id]={item_id:id,status:'pendente'};
  configurador($('view'));renderNav();};

boot();
</script>
</body>
