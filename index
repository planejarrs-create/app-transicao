<style>
:root{--brand:#E2661C;--brand-800:#B85214;--brand-600:#D25C18;--emerald:#F26A28;--mint:#FBC79A;--mint-soft:#FFEEE0;
--paper:#FFFBF7;--card:#FFFFFF;--ink:#3A2A1D;--muted:#93806F;--line:#F0E2D6;
--display:'Space Grotesk',sans-serif;--body:'Inter',sans-serif;--mono:'JetBrains Mono',monospace;--amber:#B8860B;--red:#C0392B}
:root{--logo:url('data:image/png;base64,')}
*{box-sizing:border-box}
body{margin:0;font-family:var(--body);color:var(--ink);background:var(--paper);line-height:1.5;-webkit-font-smoothing:antialiased}
button{font-family:var(--body)}.hidden{display:none!important}
.gate{position:fixed;inset:0;background:var(--brand);display:flex;align-items:center;justify-content:center;z-index:100;overflow:hidden;padding:16px}
.gate::after{content:"";position:absolute;right:-160px;top:-160px;width:460px;height:460px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.16),transparent 62%)}
.box{position:relative;z-index:2;background:var(--card);border-radius:20px;padding:34px 34px;width:min(410px,94vw);box-shadow:0 30px 70px rgba(0,0,0,.35)}
.logo{display:flex;align-items:center;gap:12px;margin-bottom:22px}
.logo svg{width:38px;height:38px;color:var(--emerald)}.logo b{font-family:var(--display);font-weight:700;font-size:25px;color:#FF6120}
.box h2{font-family:var(--display);margin:0 0 4px;color:var(--brand);font-size:19px}
.box p{margin:0 0 16px;color:var(--muted);font-size:13px}
label{display:block;font-size:12px;font-weight:600;color:var(--brand);margin:14px 0 6px;font-family:var(--mono);letter-spacing:.04em;text-transform:uppercase}
select,input,textarea{width:100%;padding:11px 13px;border:1px solid var(--line);border-radius:10px;font-family:var(--body);font-size:14px;color:var(--ink);background:#fff}
select:focus,input:focus,textarea:focus{outline:none;border-color:var(--emerald);box-shadow:0 0 0 3px rgba(15,169,104,.12)}
input[type=file]{padding:8px}
.err{color:var(--red);font-size:12.5px;margin-top:10px;min-height:16px}
.ok{color:var(--emerald)}
.btn{font-size:13.5px;font-weight:600;padding:10px 16px;border-radius:10px;border:1px solid var(--line);background:#fff;color:var(--brand);cursor:pointer;display:inline-flex;align-items:center;gap:7px}
.btn:hover{border-color:var(--emerald);color:var(--emerald)}
.btn.solid{background:var(--brand);color:#fff;border-color:var(--brand)}.btn.solid:hover{background:var(--brand-600)}
.btn.emerald{background:var(--emerald);color:#fff;border-color:var(--emerald)}.btn.emerald:hover{background:#0c8f58}
.btn.sm{padding:6px 11px;font-size:12px}.btn.ghost{border-color:transparent;background:transparent}
.btn.danger{color:var(--red)}.btn.danger:hover{border-color:var(--red)}
.btn.full{width:100%;justify-content:center;margin-top:18px}
.tabs{display:flex;gap:6px;margin-bottom:6px}
.tabs button{flex:1;padding:9px;border-radius:9px;border:1px solid var(--line);background:#fff;font-size:13px;font-weight:600;color:var(--muted);cursor:pointer}
.tabs button.on{background:var(--brand);color:#fff;border-color:var(--brand)}
#app{display:grid;grid-template-columns:250px 1fr;min-height:100vh}
aside{background:var(--brand);color:#FFF2E8;padding:20px 14px;position:sticky;top:0;height:100vh;overflow-y:auto}
.side-logo{display:flex;align-items:center;gap:10px;padding:6px 8px 18px;border-bottom:1px solid rgba(255,255,255,.12);margin-bottom:14px}
.side-logo svg{width:26px;height:26px;color:var(--mint)}.side-logo b{font-family:var(--display);font-size:19px;color:#fff}
.nav-group{font-family:var(--mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--mint);padding:14px 10px 6px;opacity:.85}
.nav a{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:9px;color:#FFF2E8;text-decoration:none;font-size:13.5px;cursor:pointer;margin-bottom:2px}
.nav a:hover{background:rgba(255,255,255,.07);color:#fff}.nav a.active{background:var(--brand-800);color:#fff}
.nav a svg{width:16px;height:16px;flex:none;stroke:currentColor;fill:none;stroke-width:2}
.nav a .mini{margin-left:auto;font-size:10.5px;font-family:var(--mono);opacity:.75}
main{min-width:0}
.topbar{display:flex;align-items:center;gap:14px;padding:14px 26px;background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:30}
.topbar h1{font-family:var(--display);font-size:18px;color:var(--brand);margin:0}.topbar .sub{font-size:12px;color:var(--muted)}
.spacer{flex:1}.userchip{display:flex;align-items:center;gap:9px;font-size:13px}
.avatar{width:32px;height:32px;border-radius:50%;background:var(--mint-soft);color:var(--emerald);display:flex;align-items:center;justify-content:center;font-weight:700;font-family:var(--display);font-size:13px}
.role-badge{font-family:var(--mono);font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;padding:3px 8px;border-radius:100px;background:var(--mint-soft);color:var(--brand-600)}
.content{padding:24px 26px 60px;max-width:1080px}
.pbar{display:flex;align-items:center;gap:14px;margin-bottom:22px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 20px}
.pbar .big{font-family:var(--display);font-size:30px;font-weight:700;color:var(--brand);line-height:1}
.pb-track{flex:1;height:10px;background:#E1EAE5;border-radius:100px;overflow:hidden}
.pb-fill{height:100%;width:0;background:linear-gradient(90deg,var(--emerald),var(--mint));transition:width .35s}
.pb-txt{font-family:var(--mono);font-size:12.5px;color:var(--brand);font-weight:600}
.grid{display:grid;gap:14px}.g3{grid-template-columns:repeat(3,1fr)}.g2{grid-template-columns:repeat(2,1fr)}
.stat{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px 20px}
.stat .k{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.stat .v{font-family:var(--display);font-size:28px;font-weight:700;color:var(--brand);margin-top:4px}
.mod-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 18px;cursor:pointer;transition:.15s}
.mod-card:hover{border-color:var(--emerald);box-shadow:0 6px 18px rgba(0,0,0,.05)}
.mod-card .name{font-family:var(--display);font-weight:600;color:var(--brand);font-size:15px;display:flex;align-items:center;gap:9px}
.mod-card .name svg{width:17px;height:17px;stroke:var(--emerald);fill:none;stroke-width:2}
.mod-card .cnt{font-size:12px;color:var(--muted);margin:8px 0 8px}
.mini-track{height:6px;background:#E1EAE5;border-radius:100px;overflow:hidden}.mini-track span{display:block;height:100%;background:var(--emerald)}
.sh{margin-bottom:16px}.sh h2{font-family:var(--display);font-size:22px;color:var(--brand);margin:0 0 3px}.sh p{margin:0;color:var(--muted);font-size:13.5px}
.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px 22px;margin-bottom:16px}
.item{border:1px solid var(--line);border-radius:12px;margin-bottom:9px;overflow:hidden;background:#fff}
.item-head{display:flex;align-items:center;gap:12px;padding:12px 14px;cursor:pointer}
.status-dot{width:11px;height:11px;border-radius:50%;flex:none;background:#C4D3CB}
.status-dot.em_andamento{background:var(--amber)}.status-dot.concluido{background:#2E9E5B}.status-dot.na{background:#9AA8A1}
.item-head .txt{flex:1;font-size:14px}
.badge{font-size:11px;font-family:var(--mono);padding:3px 9px;border-radius:100px;white-space:nowrap}
.badge.pendente{background:#EFEFEA;color:#6B6B5A}.badge.em_andamento{background:#FBF1D8;color:var(--amber)}
.badge.concluido{background:#E3F4E9;color:#227A46}.badge.na{background:#EAEDEB;color:#7A857F}
.item-head .att{font-size:11px;color:var(--muted)}
.chev{width:15px;height:15px;stroke:var(--muted);fill:none;stroke-width:2;transition:.2s}.item.open .chev{transform:rotate(180deg)}
.item-body{display:none;padding:4px 16px 16px;border-top:1px dashed var(--line);background:#FBFDFC}.item.open .item-body{display:block}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:12px}
.att-list{margin-top:10px;display:flex;flex-direction:column;gap:6px}
.att-row{display:flex;align-items:center;gap:8px;font-size:12.5px;background:#fff;border:1px solid var(--line);border-radius:8px;padding:7px 10px}
.att-row a{color:var(--emerald);text-decoration:none;font-weight:600;cursor:pointer}.att-row .rm{margin-left:auto;color:var(--red);cursor:pointer;font-size:11px}
.saveinfo{font-size:11.5px;color:var(--muted);margin-top:10px}
table{border-collapse:collapse;width:100%;font-size:13px}
th,td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--line)}th{font-family:var(--display);font-size:12px;color:var(--brand)}tr:last-child td{border-bottom:0}
.tag{font-size:11px;background:#EAF4EE;border:1px solid #D3E7DC;color:var(--brand-600);padding:3px 9px;border-radius:7px;display:inline-block;margin:2px 3px 2px 0;cursor:pointer;user-select:none}
.tag.off{background:#F1F3F2;color:#9AA8A1;border-color:#E4E9E6}
.form-inline{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;align-items:end;margin-bottom:16px}.form-inline label{margin:0 0 5px}
.hint{font-size:12px;color:var(--muted);margin-top:6px}
.warn{background:#FBF1D8;border:1px solid #EBD9A0;color:#7A5C0A;border-radius:10px;padding:12px 14px;font-size:12.5px;margin-bottom:16px;display:flex;gap:9px}
.warn svg{width:16px;height:16px;flex:none;stroke:var(--amber);fill:none;stroke-width:2;margin-top:1px}
.empty{color:var(--muted);font-size:13px;padding:14px 0}
.loading{position:fixed;inset:0;background:rgba(244,248,245,.7);display:flex;align-items:center;justify-content:center;z-index:60;font-family:var(--mono);color:var(--brand);font-size:13px}
@media(max-width:820px){#app{grid-template-columns:1fr}aside{position:static;height:auto}.frow,.g3,.g2{grid-template-columns:1fr}}

.brandimg{background:var(--logo) center/contain no-repeat}
.logo .brandimg{width:172px;height:86px;margin:0}
.side-logo{background:#fff;border-radius:12px;border-bottom:0;padding:12px;margin-bottom:16px;justify-content:center}
.side-logo .brandimg{width:154px;height:62px;margin:0 auto}

/* ---- tema claro VUCA (menu branco, laranja suave) ---- */
.gate{background:#FFF1E6}
.gate::after{background:radial-gradient(circle,rgba(242,106,40,.12),transparent 62%)}
aside{background:#FFFFFF;color:#6B5647;border-right:1px solid var(--line)}
.side-logo{background:transparent;border-bottom:1px solid var(--line);border-radius:0;padding:8px 8px 16px;margin-bottom:12px;justify-content:center}
.side-logo .brandimg{width:150px;height:60px;margin:0 auto}
.nav-group{color:var(--brand-600)}
.nav a{color:#6B5647}
.nav a:hover{background:#FFF4EC;color:var(--brand-800)}
.nav a.active{background:#FFE7D6;color:var(--brand-800)}
.nav a .mini{color:#B09A88}
.topbar h1,.pbar .big,.stat .v,.mod-card .name,.sh h2{color:var(--brand-800)}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute"><symbol id="spark" viewBox="0 0 24 24">
<g stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
<line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/>
<line x1="4.9" y1="4.9" x2="7.8" y2="7.8"/><line x1="16.2" y1="16.2" x2="19.1" y2="19.1"/><line x1="19.1" y1="4.9" x2="16.2" y2="7.8"/><line x1="7.8" y1="16.2" x2="4.9" y2="19.1"/>
</g></symbol></svg>

<!-- CONFIG (1x) -->
<div id="gateConfig" class="gate hidden"><div class="box">
  <div class="logo"><div class="brandimg"></div></div>
  <h2>Conectar ao Supabase</h2>
  <p>Cole a URL e a chave <b>anon public</b> do seu projeto (Settings › API). A chave anon é pública e fica só neste navegador.</p>
  <label>Project URL</label><input id="cfgUrl" placeholder="https://xxxx.supabase.co">
  <label>Anon public key</label><input id="cfgKey" placeholder="eyJhbGci...">
  <div class="err" id="cfgErr"></div>
  <button class="btn solid full" onclick="saveConfig()">Conectar</button>
  <div class="hint" style="margin-top:12px">Rode antes o script SQL no projeto para criar as tabelas.</div>
</div></div>

<!-- LOGIN -->
<div id="gateLogin" class="gate hidden"><div class="box">
  <div class="logo"><div class="brandimg"></div></div>
  <div class="tabs"><button id="tabIn" class="on" onclick="authTab('in')">Entrar</button><button id="tabUp" onclick="authTab('up')">Criar conta</button></div>
  <div id="upName" class="hidden"><label>Nome</label><input id="auName" placeholder="Seu nome"></div>
  <label>E-mail</label><input id="auEmail" type="email" placeholder="voce@empresa.com" onkeydown="if(event.key==='Enter')doAuth()">
  <label>Senha</label><input id="auPass" type="password" placeholder="••••••••" onkeydown="if(event.key==='Enter')doAuth()">
  <div class="err" id="auErr"></div>
  <button class="btn solid full" id="auBtn" onclick="doAuth()">Entrar</button>
