<script type="module">
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';
// >>> EDITE AQUI se trocar de projeto (Supabase > Settings > API) <<<
const SB_URL='https://stvwffwgbpvajnslwksh.supabase.co';
const SB_KEY='sb_publishable_oJ2FJ1b1thFYnNTXyY5IvQ_-6sTqzat';
// >>> a logo real (PNG) entra na tag <img id="brandLogo"> quando voce enviar <<<

const ICON={conta:'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M9 13h6 M9 17h6',fiscal:'M9 3v18 M15 3v18 M4 8h16 M4 16h16',dp:'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2 M9 7a4 4 0 1 0 0 .01 M23 21v-2a4 4 0 0 0-3-3.87',tes:'M12 1v22 M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6',ctrl:'M3 3v18h18 M7 14l4-4 3 3 5-6',patr:'M3 21h18 M5 21V8l7-5 7 5v13 M9 21v-6h6v6',est:'M21 8V21H3V8 M1 3h22v5H1z M10 12h4',obr:'M9 11l3 3L22 4 M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11',aud:'M11 3a8 8 0 1 0 0 16 8 8 0 0 0 0-16z M21 21l-4.3-4.3',comp:'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',ti:'M4 4h16v12H4z M2 20h20 M9 16v4 M15 16v4',erp:'M4 4h16v16H4z M4 9h16 M9 4v16',kpi:'M18 20V10 M12 20V4 M6 20v-6',team:'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2 M9 7a4 4 0 1 0 0 .01 M23 21v-2a4 4 0 0 0-3-3.87',gov:'M3 21h18 M12 3l9 6H3z M6 9v9 M18 9v9',plan:'M12 20V10 M18 20V4 M6 20v-4 M2 20h20'};
const STATUS=[['pendente','Pendente'],['em_andamento','Em andamento'],['concluido','Concluído'],['na','Não aplicável']];
const $=id=>document.getElementById(id);
const load=on=>$('loading').classList.toggle('hidden',!on);
function p(d){return d.split(' M').map((s,i)=>`<path d="${i?'M'+s:s}"/>`).join('');}
function esc(s){return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

let sb=null, ST={}, route={view:'dash',mod:null}, authMode='in';

/* ---------- config ---------- */
function showConfig(){$('app').classList.add('hidden');$('gateLogin').classList.add('hidden');$('gateConfig').classList.remove('hidden');
  $('cfgUrl').value=localStorage.getItem('sb_url')||'';$('cfgKey').value=localStorage.getItem('sb_key')||'';}
window.showConfig=showConfig;
window.saveConfig=function(){const u=$('cfgUrl').value.trim(),k=$('cfgKey').value.trim();
  if(!/^https:\/\/.+\.supabase\.co/.test(u)||k.length<20){$('cfgErr').textContent='URL ou chave inválida.';return;}
  localStorage.setItem('sb_url',u);localStorage.setItem('sb_key',k);boot();};

/* ---------- auth ---------- */
window.authTab=function(m){authMode=m;$('tabIn').classList.toggle('on',m==='in');$('tabUp').classList.toggle('on',m==='up');
  $('upName').classList.toggle('hidden',m!=='up');$('auBtn').textContent=m==='up'?'Criar conta':'Entrar';$('auErr').textContent='';};
window.doAuth=async function(){const email=$('auEmail').value.trim(),pass=$('auPass').value;$('auErr').textContent='';
  if(!email||!pass){$('auErr').textContent='Informe e-mail e senha.';return;}load(true);
  try{
    if(authMode==='up'){const{error}=await sb.auth.signUp({email,password:pass,options:{data:{nome:$('auName').value.trim()||email}}});
      if(error)throw error;$('auErr').innerHTML='<span class="ok">Conta criada. Se a confirmação por e-mail estiver ativa, confirme antes de entrar.</span>';authTab('in');}
    else{const{error}=await sb.auth.signInWithPassword({email,password:pass});if(error)throw error;await enter();}
  }catch(e){$('auErr').textContent=e.message||'Falha na autenticação.';}finally{load(false);}};
window.logout=async function(){await sb.auth.signOut();ST={};$('app').classList.add('hidden');$('gateLogin').classList.remove('hidden');};

/* ---------- boot ---------- */
async function boot(){
  const url=SB_URL||localStorage.getItem('sb_url'),key=SB_KEY||localStorage.getItem('sb_key');
  if(!url||!key){showConfig();return;}
  sb=createClient(url,key);
  $('gateConfig').classList.add('hidden');
  try{const{data:{session}}=await sb.auth.getSession();
    if(session){await enter();}else{$('gateLogin').classList.remove('hidden');}}
  catch(e){$('gateLogin').classList.remove('hidden');}
}
window.boot=boot;

async function enter(){
  load(true);
  try{
    const{data:{user},error:uerr}=await sb.auth.getUser();
    if(uerr||!user){await sb.auth.signOut();$('app').classList.add('hidden');$('gateLogin').classList.remove('hidden');load(false);return;}
    let{data:prof}=await sb.from('profiles').select('*').eq('id',user.id).maybeSingle();
    if(!prof){await sb.from('profiles').insert({id:user.id,nome:user.email,email:user.email});prof={id:user.id,nome:user.email,role:'membro'};}
    ST.profile=prof;
    await loadAll();
    $('gateLogin').classList.add('hidden');$('app').classList.remove('hidden');
    $('uName').textContent=prof.nome||user.email;$('uRole').textContent=roleName(prof.role);$('uAv').textContent=(prof.nome||user.email||'?')[0].toUpperCase();
    route={view:'dash',mod:null};renderNav();render();
  }catch(e){alert('Erro ao carregar: '+(e.message||e));}finally{load(false);}
}
function roleName(r){return r==='admin'?'Administrador':r==='gestor'?'Gestor':r==='diretoria'?'Diretoria':'Membro';}
function isAdmin(){return ['admin','gestor'].includes(ST.profile.role);}
function canWrite(){return ST.profile.role!=='diretoria';}

async function loadAll(){
  const[mods,items,status,eq,dir,cart,ges,anx]=await Promise.all([
    sb.from('modulo').select('*').order('ordem'),
    sb.from('item').select('*').order('ordem'),
    sb.from('item_status').select('*'),
    sb.from('equipe').select('*').order('nome'),
    sb.from('diretoria').select('*').order('nome'),
    sb.from('carteira').select('*').order('nome'),
    sb.from('gestor').select('*'),
    sb.from('anexo').select('*')
  ]);
  ST.modules=mods.data||[];
  ST.items={};(items.data||[]).forEach(it=>{(ST.items[it.modulo_key]=ST.items[it.modulo_key]||[]).push(it);});
  ST.status={};(status.data||[]).forEach(s=>ST.status[s.item_id]=s);
  ST.equipe=eq.data||[];ST.diretoria=dir.data||[];ST.carteiras=cart.data||[];
  ST.gestores={};(ges.data||[]).forEach(g=>ST.gestores[g.tipo]=g);
  ST.anexos={};(anx.data||[]).forEach(a=>{(ST.anexos[a.item_id]=ST.anexos[a.item_id]||[]).push(a);});
  // módulos visíveis
  if(ST.profile.role==='membro'){
    const{data}=await sb.from('acesso_modulo').select('modulo_key').eq('profile_id',ST.profile.id);
    ST.access=(data||[]).map(x=>x.modulo_key);
  }else ST.access='all';
}
function canModule(k){return ST.access==='all'||ST.access.includes(k);}
function visibleModules(){return ST.modules.filter(m=>canModule(m.key));}

