window.go=function(v,mod){if(v==='mod'&&!canModule(mod))return;route={view:v,mod:mod||null};highlight();render();};

/* ---------- stats ---------- */
function modStats(k){const items=ST.items[k]||[];let ok=0,and=0;items.forEach(it=>{const s=(ST.status[it.id]||{}).status;if(s==='concluido')ok++;if(s==='em_andamento')and++;});return{tot:items.length,ok,and};}
function globalStats(){let tot=0,ok=0,and=0,pend=0;ST.modules.forEach(m=>{(ST.items[m.key]||[]).forEach(it=>{tot++;const s=(ST.status[it.id]||{}).status;if(s==='concluido')ok++;else if(s==='em_andamento')and++;else pend++;});});return{tot,ok,and,pend};}

/* ---------- render ---------- */
function setTitle(t,s){$('pgTitle').textContent=t;$('pgSub').textContent=s||'';}
function render(){const v=route.view,b=$('view');
  if(v==='dash')return dash(b);
  if(v==='mod')return modView(b,route.mod);
  if(v==='diretoria')return people(b,'diretoria');
  if(v==='equipe')return people(b,'equipe');
  if(v==='gestores')return gestores(b);
  if(v==='carteiras')return carteiras(b);
  if(v==='usuarios')return users(b);
  if(v==='config')return configurador(b);
}
function dash(b){setTitle('Painel da transição','Visão geral do progresso');const g=globalStats(),pct=g.tot?Math.round(g.ok/g.tot*100):0;const mods=visibleModules();
  b.innerHTML=`<div class="pbar"><div class="big">${pct}%</div><div style="flex:1"><div style="font-weight:600;margin-bottom:6px">Conclusão geral</div><div class="pb-track"><div class="pb-fill" style="width:${pct}%"></div></div></div><div class="pb-txt">${g.ok}/${g.tot} itens</div></div>
   <div class="grid g3" style="margin-bottom:22px">
     <div class="stat"><div class="k">Concluídos</div><div class="v" style="color:#2E9E5B">${g.ok}</div></div>
     <div class="stat"><div class="k">Em andamento</div><div class="v" style="color:var(--amber)">${g.and}</div></div>
     <div class="stat"><div class="k">Pendentes</div><div class="v">${g.pend}</div></div></div>
   <div class="sh"><h2>Módulos</h2><p>Acesso a ${mods.length} de ${ST.modules.length} módulos.</p></div>
   <div class="grid g3">${mods.map(m=>{const s=modStats(m.key),pc=s.tot?Math.round(s.ok/s.tot*100):0;
     return `<div class="mod-card" onclick="go('mod','${m.key}')"><div class="name"><svg viewBox="0 0 24 24">${p(ICON[m.key]||'')}</svg>${esc(m.nome)}</div><div class="cnt">${s.ok}/${s.tot} concluídos · ${pc}%</div><div class="mini-track"><span style="width:${pc}%"></span></div></div>`;}).join('')}</div>`;}

function modView(b,k){const m=ST.modules.find(x=>x.key===k);setTitle(m.nome,'Status, responsável, observação e anexos');const items=ST.items[k]||[],s=modStats(k),pct=s.tot?Math.round(s.ok/s.tot*100):0,ro=!canWrite();
  b.innerHTML=`<div class="pbar"><div class="big">${pct}%</div><div style="flex:1"><div style="font-weight:600;margin-bottom:6px">${esc(m.nome)}</div><div class="pb-track"><div class="pb-fill" style="width:${pct}%"></div></div></div><div class="pb-txt">${s.ok}/${s.tot}</div></div>
   ${ro?'<div class="warn"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4 M12 16h.01"/></svg>Perfil Diretoria: somente leitura.</div>':''}
   ${items.map(it=>itemHTML(it,ro)).join('')}`;}
function itemHTML(it,ro){const st=ST.status[it.id]||{status:'pendente'};const label=(STATUS.find(x=>x[0]===st.status)||STATUS[0])[1];const att=ST.anexos[it.id]||[];const iid=it.id.replace('.','_');
  return `<div class="item" id="it_${iid}"><div class="item-head" onclick="tog('${it.id}')">
    <span class="status-dot ${st.status}"></span><span class="txt">${esc(it.descricao)}</span>
    ${att.length?`<span class="att">📎 ${att.length}</span>`:''}${st.obs?'<span class="att">📝</span>':''}
    <span class="badge ${st.status}">${label}</span><svg class="chev" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></div>
    <div class="item-body">
      <div class="frow">
        <div><label>Status</label><select ${ro?'disabled':''} onchange="setField('${it.id}','status',this.value)">${STATUS.map(s=>`<option value="${s[0]}" ${st.status===s[0]?'selected':''}>${s[1]}</option>`).join('')}</select></div>
        <div><label>Responsável</label><select ${ro?'disabled':''} onchange="setField('${it.id}','responsavel_id',this.value||null)"><option value="">— selecione —</option>${ST.equipe.map(e=>`<option value="${e.id}" ${st.responsavel_id===e.id?'selected':''}>${esc(e.nome)}${e.funcao?' ('+esc(e.funcao)+')':''}</option>`).join('')}</select></div>
      </div>
      <label style="margin-top:14px">Observação</label>
      <textarea rows="2" ${ro?'disabled':''} placeholder="Anotações, pendências, riscos. Não registre senhas/certificados aqui." onchange="setField('${it.id}','obs',this.value)">${esc(st.obs)}</textarea>
      <div class="frow" style="grid-template-columns:auto 1fr;align-items:center;margin-top:12px">
        <div>${ro?'':`<label style="margin:0 0 6px">Anexar evidência</label><input type="file" onchange="attach('${it.id}',this)">`}</div>
        <div class="att-list" id="att_${iid}">${attHTML(it.id,att,ro)}</div>
      </div>
      ${st.updated_at?`<div class="saveinfo">Atualizado em ${new Date(st.updated_at).toLocaleString('pt-BR')}</div>`:''}
    </div></div>`;}
function attHTML(id,att,ro){if(!att.length)return'<span class="hint">Nenhum anexo.</span>';
  return att.map(a=>`<div class="att-row">📄 <a onclick="dl('${a.storage_path}','${esc(a.nome)}')">${esc(a.nome)}</a><span class="hint">${a.tamanho?(a.tamanho>1e6?(a.tamanho/1e6).toFixed(1)+' MB':(a.tamanho/1e3).toFixed(0)+' KB'):''}</span>${ro?'':`<span class="rm" onclick="rmAtt('${id}','${a.id}','${a.storage_path}')">remover</span>`}</div>`).join('');}
window.tog=id=>$('it_'+id.replace('.','_')).classList.toggle('open');

window.setField=async function(id,f,v){try{
  const{error}=await sb.from('item_status').upsert({item_id:id,[f]:v,updated_by:ST.profile.id},{onConflict:'item_id'});
  if(error)throw error;ST.status[id]=ST.status[id]||{item_id:id};ST.status[id][f]=v;ST.status[id].updated_at=new Date().toISOString();
  if(f==='status'){modView($('view'),route.mod);$('it_'+id.replace('.','_')).classList.add('open');renderNav();}
}catch(e){alert('Erro ao salvar: '+e.message);}};

window.attach=async function(id,input){const file=input.files[0];if(!file)return;load(true);
  try{const path=`${id}/${Date.now()}_${file.name}`;
    const{error:ue}=await sb.storage.from('anexos').upload(path,file);if(ue)throw ue;
    const{data,error}=await sb.from('anexo').insert({item_id:id,storage_path:path,nome:file.name,mime:file.type,tamanho:file.size,uploaded_by:ST.profile.id}).select().single();
    if(error)throw error;(ST.anexos[id]=ST.anexos[id]||[]).push(data);
    $('att_'+id.replace('.','_')).innerHTML=attHTML(id,ST.anexos[id],false);input.value='';
  }catch(e){alert('Erro no upload: '+e.message);}finally{load(false);}};
window.dl=async function(path,name){const{data,error}=await sb.storage.from('anexos').createSignedUrl(path,60,{download:name});
  if(error){alert('Erro: '+error.message);return;}const a=document.createElement('a');a.href=data.signedUrl;a.download=name;a.click();};
window.rmAtt=async function(id,aid,path){if(!confirm('Remover anexo?'))return;load(true);
  try{await sb.storage.from('anexos').remove([path]);const{error}=await sb.from('anexo').delete().eq('id',aid);if(error)throw error;
    ST.anexos[id]=(ST.anexos[id]||[]).filter(a=>a.id!==aid);$('att_'+id.replace('.','_')).innerHTML=attHTML(id,ST.anexos[id],false);
  }catch(e){alert('Erro: '+e.message);}finally{load(false);}};

